*.dmg
*.msi
*-setup.exe

# Environment and secrets (keep the example, never commit a filled-in env)
.env
.env.*
!.env.example
*.key
*.key.pub
*.p12
*.pfx
*.cer
src-tauri/signing/*
!src-tauri/signing/.gitkeep
!src-tauri/signing/README.md

# Lock files are intentionally committed for reproducible builds.

