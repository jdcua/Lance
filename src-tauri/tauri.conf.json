{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-apps/main/schemas/config.schema.json",
  "productName": "Lance",
  "version": "1.0.0",
  "identifier": "co.decentra.lance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lance",
        "width": 1100,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb"],
    "identifier": "co.decentra.lance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Freelancer OS",
    "longDescription": "Win work. Run projects. Get paid. Run your business.",
    "copyright": "Copyright \u00a9 2026 Decentra. All rights reserved.",
    "category": "Productivity",
    "externalBin": [],
    "resources": [],
    "nsis": {
      "displayLanguageSelector": false,
      "languages": ["English"],
      "oneClick": true,
      "perMachine": false
    },
    "wix": {
      "language": "en-US"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "providerShortName": null
    },
    "dmg": {
      "background": "assets/dmg-background.png",
      "windowWidth": 540,
      "windowHeight": 380
    },
    "appimage": {
      "bundleMediaFramework": false
    },
    "deb": {
      "depends": []
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:lance.db"]
    },
    "updater": {
      "endpoints": ["https://lance.decentra.co/releases/{{target}}/{{arch}}/{{current_version}}"],
      "dialog": false,
      "pubkey": "__UPDATER_PUBLIC_KEY__"
    }
  }
}
