{
  "$schema": "gen/schemas/desktop-schema.json",
  "productName": "Lance",
  "version": "0.9.9-2",
  "identifier": "co.MONDAY.lance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lance",
        "width": 1100,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.bunny.net; font-src 'self' https://fonts.bunny.net; img-src 'self' asset: data:; connect-src 'self' https://pay.paddle.io https://*.paddle.com https://*.placeholderlabsincorporatedlimited.yabbadabbadoo; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Freelancer OS",
    "longDescription": "Win work. Run projects. Get paid. Run your business.",
    "copyright": "Copyright © 2026 Placeholder Labs Incorporated Limited. All rights reserved.",
    "category": "Productivity",
    "externalBin": [],
    "resources": []
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:lance.db"]
    },
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": ["https://lance.cuajuandiego.workers.dev/api/updates/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMDc4QzU0RDdDQTkwNjQKUldSa2tNclhWSXdIMjNSNDAvb1hkKzQ1MWJPRG1vNXE4Q0o4dDdtaEw0ZTJnWGJkOFU4SGZBa28K",
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
