{
  "$schema": "gen/schemas/desktop-schema.json",
  "productName": "Lance",
  "version": "1.0.0",
  "identifier": "co.decentra.lance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lance",
        "width": 1100,
        "height": 680,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.bunny.net; font-src 'self' https://fonts.bunny.net; img-src 'self' asset: data:; connect-src 'self' https://api.anthropic.com; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png"],
    "shortDescription": "Freelancer OS",
    "longDescription": "Win work. Run projects. Get paid. Run your business.",
    "copyright": "Copyright © 2026 Decentra. All rights reserved.",
    "category": "Productivity",
    "externalBin": [],
    "resources": []
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:lance.db"]
    },
    "shell": {
      "open": true
    },
    "updater": {
      "active": true,
      "endpoints": ["https://github.com/jdcua/lance/releases/latest/download/latest.json"],
      "pubkey": "__LANCE_PUBKEY__",
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
