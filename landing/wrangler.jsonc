{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lance",
  "main": "_worker.js",
  "compatibility_date": "2026-06-24",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "compatibility_flags": ["nodejs_compat"],
}
